# KazMorph environment configuration.
# Copy to `.env` and fill in real values before `docker compose up`.
# Never commit the real `.env` — it is gitignored.

# ─── Server ────────────────────────────────────────────────────────────
# External port the app is exposed on.
PORT=8080
# Number of uvicorn workers (≈ CPU cores). Set to 1 with --reload for dev.
WORKERS=4

# ─── Database (PostgreSQL) ─────────────────────────────────────────────
POSTGRES_USER=kazmorph
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kazmorph
# For local runs without Docker (psycopg2 driver):
# DATABASE_URL=postgresql+psycopg2://kazmorph:change-me@localhost:5432/kazmorph

# ─── Security ──────────────────────────────────────────────────────────
# Secret for signing session cookies — set to a long random string in prod.
SESSION_SECRET=dev-insecure-change-me
# Set to 1 to mark cookies Secure (HTTPS only). Leave empty behind plain HTTP.
SESSION_SECURE=

# Optional API key for /api/v1/* — empty = open public API (local dev).
KAZMORPH_API_KEY=

# ─── Active Learning (LLM reviewer + RSS harvester) ────────────────────
# Anthropic API key (pay-per-token). Required only for scripts/llm_review.py.
ANTHROPIC_API_KEY=
LLM_PROVIDER=claude
LLM_REVIEW_MODEL=claude-haiku-4-5
# Days to retain scraped raw text before automatic deletion.
RAW_TEXT_RETENTION_DAYS=7

# ─── Локальный LLM вместо платного Anthropic API (опционально) ─────────
# Чтобы запускать цикл Active Learning на локальной модели (бесплатно, без
# внешних вызовов), переключите провайдер на ollama и задайте модель/URL:
#   LLM_PROVIDER=ollama
#   LLM_REVIEW_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL можно направить на любой OpenAI-совместимый сервер
# (Ollama, vLLM, LM Studio, llama.cpp).
OLLAMA_BASE_URL=http://localhost:11434/v1
